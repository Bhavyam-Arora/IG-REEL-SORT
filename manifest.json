{
  "manifest_version": 3,
  "name": "Sortcut",
  "key":"",
  "version": "0.2.0",
  "description": "Sort any Instagram profile's posts and reels by views, likes, comments, or date. Find outliers and export to CSV.",
  "permissions": ["storage", "activeTab", "identity"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://uc7bn8aln5.execute-api.ap-southeast-2.amazonaws.com/*",
    "https://sortcut-dev-audio-590854469967.s3.ap-southeast-2.amazonaws.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/extract.js", "page/interceptor.js", "page/collector.js"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
